DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parrot

# ---- Web (Next.js dashboard) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
APP_URL=http://localhost:3000
SESSION_SECRET=

# ---- Worker ----
BOT_USERNAME=parrotbot
BOT_OAUTH=oauth:xxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=
MODEL=claude-haiku-4-5-20251001
BATCH_WINDOW_MS=30000
BATCH_MAX_SIZE=10
CONFIDENCE_THRESHOLD=0.8
DAILY_TOKEN_CAP_PER_CHANNEL=200000
INTENT_COOLDOWN_MIN=5
AUTHOR_RATE_LIMIT_SEC=60
INJECTION_STRIKE_LIMIT=3
PORT=3001
LOG_LEVEL=info
DATA_DIR=./data

# Optional R2 (worker still runs locally without these — JSONL stays on disk)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=parrot-logs
