{
  "name": "parrotbot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web",
    "worker"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web:server": "npm --workspace web run dev:server",
    "dev:web:css": "npm --workspace web run dev:css",
    "dev:worker": "npm --workspace worker run dev",
    "build": "npm --workspace web run build && npm --workspace worker run build",
    "test": "npm --workspace web run test && npm --workspace worker run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.2"
  }
}
