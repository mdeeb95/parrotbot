{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --workspaces --include-workspace-root && npm --workspace worker run build"
  },
  "deploy": {
    "startCommand": "npm --workspace worker run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ALWAYS"
  }
}
