{
  "name": "parrot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:css": "tailwindcss -i input.css -o public/app.css --watch",
    "build": "tailwindcss -i input.css -o public/app.css --minify",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@parrot/db": "*",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^20.16.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
